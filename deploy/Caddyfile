{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@sse path /api/conversations/*/ai/completions /api/rooms/*/ai/ask
	handle @sse {
		reverse_proxy app:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				dial_timeout 5s
			}
		}
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy app:8000 {
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	handle /api/* {
		reverse_proxy app:8000 {
			transport http {
				read_timeout 30s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}
